# Redis config with real passwords — keep the .example, ignore the real one
.config/redis.conf

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# npm package lock files
package-lock.json
yarn.lock

# Ignore all files in uploads directory
/public/uploads/*
# But not the directory itself
!/public/uploads/.keep
# Ignore all files in uploads except for .keep
!/public/uploads/.gitkeep

