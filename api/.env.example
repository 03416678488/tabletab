APP_NAME=nest-api
APP_DESCRIPTION=nest-api
APP_VERSION=1.0.0
APP_PORT=3000

# Postgres Config
POSTGRES_HOST=my-postgres-docker-service
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DATABASE=nest-crud
RUN_MIGRATIONS=false

#Redis Config
REDIS_HOST=my-redis-docker-service
REDIS_PORT=6379
REDIS_USERNAME=root
REDIS_PASSWORD=root

# JWT Config
# Generate each secret independently (e.g. `openssl rand -hex 64`).
# JWT_SECRET and REFRESH_JWT_SECRET MUST be different values — sharing one key
# would let a refresh token be replayed as an access token.
JWT_SECRET=replace-with-openssl-rand-hex-64
JWT_EXPIRES_IN=15m
REFRESH_JWT_SECRET=replace-with-a-different-openssl-rand-hex-64
REFRESH_JWT_EXPIRES_IN=30d

# Encrypts stored integration credentials (marketplace connectors) at rest.
# Falls back to JWT_SECRET if unset. MUST stay stable — changing it makes
# existing encrypted credentials unreadable (reconnect the integrations).
# openssl rand -hex 64
INTEGRATION_ENC_KEY=feb491289d567747861f451ffa61f3b527eb1922c8ce2992f8499ab753a3b74a78c64d875ea4294b394b44e6920c450cb631410d8eb6f0bed66d4cab30c99171

# Frontend URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_NETWORK=http://localhost:3000