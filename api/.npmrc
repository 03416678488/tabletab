# @nestjs/cache-manager@2 declares an over-strict peer range (@nestjs/common
# ^9||^10) but runs fine on Nest 11. Its v3 requires cache-manager >=6 (the Keyv
# rewrite), which would break our cache-manager-redis-yet/-store/-ioredis stores,
# so we intentionally stay on v2. legacy-peer-deps lets the install resolve.
legacy-peer-deps=true
