# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Monorepo root: patterns are unanchored so they apply to both client/ and api/.
# (api/ also has its own .gitignore with a few extra, api-specific rules.)

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Builds / compiled output
.next/
out/
build/
dist/

# Testing
coverage/
.nyc_output/

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Env files (keep the *.example templates)
.env
.env.*
!.env.example

# TypeScript / Next
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Temp
.temp
.tmp

# --- api-specific ---
# Redis config holding real passwords — the .example is committed, the real one is not.
api/.config/redis.conf
